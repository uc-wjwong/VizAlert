        <rows>(([federated.06mx4tt0velwek148tvn8086cstf].[none:Calculation_1958784389670035479:ok] / ([federated.06mx4tt0velwek148tvn8086cstf].[none:Calculation_1958784389669875734:ok] / ([federated.06mx4tt0velwek148tvn8086cstf].[none:Calculation_1958784389669167120:nk] / [federated.06mx4tt0velwek148tvn8086cstf].[none:Calculation_1958784389669654548:nk]))) * [federated.06mx4tt0velwek148tvn8086cstf].[none:tx_value (Custom SQL Query7):qk])</rows>
