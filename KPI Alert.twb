    <worksheet name='Resolved_Vizalert'>
      <repository-location derived-from='http://10.244.138.8/workbooks/KPIAlert_17525440428590/Resolved_Vizalert?rev=' id='Resolved_Vizalert' path='/workbooks/KPIAlert_17525440428590' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='Main' name='federated.06mx4tt0velwek148tvn8086cstf' />
          </datasources>
          <datasource-dependencies datasource='federated.06mx4tt0velwek148tvn8086cstf'>
            <column caption=' Email Footer' datatype='string' name='[ Email Header ~ (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&lt;br&gt;&apos;&#13;&#10;+ &apos;-&apos;' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Text string that will be inserted one time at the end of the email body. It is expected to be in HTML format. Generally, this field is useful in conjunction with &quot;Consolidate Lines&quot;. Edit the calc for usage examples.</run>
                  <run bold='true'>

If not provided, a standard VizAlerts footer will be used by default. To use no footers, add this field to your viz as an empty string &apos;&apos;.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption=' Email Body' datatype='string' name='[ Email To * (copy) (copy) (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Text string in HTML format to use for the Body of your email.&#13;&#10;// Default value is empty (a blank body):&#13;&#10;&#13;&#10;&apos;&lt;span style=&quot;font-family: Verdana; font-size: 20px;&quot;&gt;To redirect to the Alert dashboard, click VIZ_LINK(KPIAlert/AlertsOverview|filename=here).&lt;/span&gt;&lt;br&gt;&apos;&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &apos;&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; font-family: Verdana; font-size: 20px;&quot;&gt;&#13;&#10;  &lt;thead style=&quot;background-color: #f2f2f2;&quot;&gt;&#13;&#10;    &lt;tr&gt;&#13;&#10;      &lt;th&gt;Alert Status&lt;/th&gt;&#13;&#10;      &lt;th&gt;Total&lt;/th&gt;&#13;&#10;      &lt;th&gt;Normal Traffic&lt;/th&gt;&#13;&#10;      &lt;th&gt;VIP Traffic&lt;/th&gt;&#13;&#10;    &lt;/tr&gt;&#13;&#10;  &lt;/thead&gt;&#13;&#10;  &lt;tbody&gt;&#13;&#10;    &lt;tr&gt;&#13;&#10;      &lt;td&gt;New&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([new_cnt] + [new_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([new_cnt]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([new_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;    &lt;/tr&gt;&#13;&#10;    &lt;tr&gt;&#13;&#10;      &lt;td&gt;Existing&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([existing_cnt] + [existing_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([existing_cnt]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([existing_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;    &lt;/tr&gt;&#13;&#10;    &lt;tr&gt;&#13;&#10;      &lt;td&gt;Resolved&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([resolved_cnt] + [resolved_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([resolved_cnt]) + &apos;&lt;/td&gt;&#13;&#10;      &lt;td&gt;&apos; + STR([resolved_cnt_vip]) + &apos;&lt;/td&gt;&#13;&#10;    &lt;/tr&gt;&#13;&#10;  &lt;/tbody&gt;&#13;&#10;&lt;/table&gt;&#13;&#10;&apos;&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &apos;&lt;u&gt;&lt;span style=&quot;font-family: Verdana; font-size: 20px;&quot;&gt;New Alert&lt;/span&gt;&lt;/u&gt;&lt;br&gt;&apos;&#13;&#10;+ IF ([new_cnt] + [new_cnt_vip]) != 0 THEN &quot;VIZ_IMAGE(KPIAlert_17525440428590/New_Vizalert|width=100%)&quot; ELSE &quot;&quot; END&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &apos;&lt;u&gt;&lt;span style=&quot;font-family: Verdana; font-size: 20px;&quot;&gt;Existing Alert&lt;/span&gt;&lt;/u&gt;&lt;br&gt;&apos;&#13;&#10;+ IF ([existing_cnt] + [existing_cnt_vip]) != 0 THEN &quot;VIZ_IMAGE(KPIAlert_17525440428590/Existing_Vizalert|width=100%)&quot; ELSE &quot;&quot; END&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &quot;&lt;br&gt;&quot;&#13;&#10;+ &apos;&lt;u&gt;&lt;span style=&quot;font-family: Verdana; font-size: 20px;&quot;&gt;Resolved Alert&lt;/span&gt;&lt;/u&gt;&lt;br&gt;&apos;&#13;&#10;+ IF ([resolved_cnt] + [resolved_cnt_vip]) != 0 THEN &quot;VIZ_IMAGE(KPIAlert_17525440428590/Resolved_Vizalert|width=100%)&quot; ELSE &quot;&quot; END&#13;&#10;&#13;&#10;// *** TIP 1 ***: &#13;&#10;// Basic HTML formatting&#13;&#10;//      Bold, italic, underline: &apos;This is &lt;b&gt;bold&lt;/b&gt;, &lt;i&gt;italic&lt;/i&gt;, and &lt;/u&gt;underline&lt;/u&gt;.&apos;&#13;&#10;//      Hyperlink: &apos;This is a &lt;a href=&quot;http://yoursite.com&quot;&gt;hyperlink&lt;/a&gt;.&apos;&#13;&#10;//      Table:&#13;&#10;//              &apos;&lt;table&gt;&#13;&#10;//                      &lt;tr&gt;&lt;td&gt;Column 1&lt;/td&gt;&lt;td&gt;Column 2&lt;/td&gt;&lt;/tr&gt;&#13;&#10;//                      &lt;tr&gt;&lt;td&gt;Value 1&lt;/td&gt;&lt;td&gt;Value 2&lt;/td&gt;&lt;/tr&gt;&#13;&#10;//                      &lt;tr&gt;&lt;td&gt;Value 3&lt;/td&gt;&lt;td&gt;Value 4&lt;/td&gt;&lt;/tr&gt;&#13;&#10;//               &lt;/table&gt;&apos;&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 2 ***: &#13;&#10;// Add fields from your data to customize the body&#13;&#10;// Example:&#13;&#10;//        &apos;Happy birthday, &apos; + [Person Name] + &apos;! You are &apos; + STR([Person Age]) + &apos; today!&apos;&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 3 ***: ent &#13;&#10;// Embed images using the VIZ_IMAGE() content reference! (see the Content Reference Examples folder in the Data pane for more on this)' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Text string to use as the Body field of the email. It is expected to be in HTML format.</run>
                  <run bold='true'>

If not provided, an linked image of the viz will be used by default.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption=' Email Subject' datatype='string' name='[ Email To * (copy) (copy) (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;[KPI ALERT] &apos; + STR([new_cnt] + [existing_cnt] + [new_cnt_vip] + [existing_cnt_vip]) + &apos; Thresholds Breach Detected @ &apos; + LEFT(STR(NOW()), 19)' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Text string to be used as the Subject of the email.</run>
                  <run bold='true'>

If not provided, a standard VizAlerts subject will be used by default.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='submit_true' datatype='boolean' name='[Calculation_1265792977112461313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='Details' datatype='string' name='[Calculation_1958784389669167120]' role='dimension' type='nominal' user:unnamed='Vizalert'>
              <calculation class='tableau' formula='//Details&#13;&#10;[details_title]' />
            </column>
            <column caption='Info' datatype='string' name='[Calculation_1958784389669654548]' role='dimension' type='nominal' user:unnamed='Vizalert'>
              <calculation class='tableau' formula='//Info&#13;&#10;[details (Custom SQL Query7)]' />
            </column>
            <column caption='Item ID' datatype='integer' name='[Calculation_1958784389669875734]' role='measure' type='quantitative' user:unnamed='Vizalert'>
              <calculation class='tableau' formula='//Item ID&#13;&#10;[threshold_id]' />
            </column>
            <column caption='Sorting' datatype='integer' name='[Calculation_1958784389670035479]' role='measure' type='quantitative' user:unnamed='Vizalert'>
              <calculation class='tableau' formula='//Sorting&#13;&#10;[alert_cnt]' />
            </column>
            <column caption=' Email Action *' datatype='integer' name='[Calculation_2500331092646743]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// A value of &quot;1&quot; means, &quot;send an email&quot;. Any other value will result in no email being sent.&#13;&#10;// Default value is 1:&#13;&#10;[alert_trigger]&#13;&#10;&#13;&#10;// *** TIP 1 ***: &#13;&#10;// Build a calc to return the value of &quot;1&quot; only when your alert condition is met:&#13;&#10;// Example: IF SUM([Sales]) &gt; 45664 THEN 1 ELSE 0 END&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 2 ***: &#13;&#10;// It can be helpful to add a relative date conidition to avoid alerting you to data you&apos;ve already been alerted to&#13;&#10;// Examples below:&#13;&#10;&#13;&#10;//        // Your Date occurred during the PREVIOUS DAY (for alerts that every day)&#13;&#10;//           (DATETRUNC(&apos;day&apos;, [Your Date Field]) =&#13;&#10;//               DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;day&apos;, NOW())))&#13;&#10;//&#13;&#10;//&#13;&#10;//        // Your Date occurred during the PREVIOUS HOUR (for alerts that run every hour)&#13;&#10;//           (DATETRUNC(&apos;hour&apos;, [Your Date Field]) =&#13;&#10;//               DATEADD(&apos;hour&apos;, -1, DATETRUNC(&apos;hour&apos;, NOW())))&#13;&#10;//&#13;&#10;//&#13;&#10;//        // Your Date during the PREVIOUS QUARTER HOUR (for alerts that run every 15 minutes)&#13;&#10;//           ([Your Date Field] &gt; &#13;&#10;//               DATEADD(&apos;minute&apos;, -15, &#13;&#10;//                   DATEADD(&apos;minute&apos;, &#13;&#10;//                       (INT(DATEPART(&apos;minute&apos;, NOW()) / 15)) * 15, &#13;&#10;//                       DATETRUNC(&apos;hour&apos;, now()) )&#13;&#10;//               )&#13;&#10;//           AND&#13;&#10;//           [Your Date Field] &lt;= &#13;&#10;//               DATEADD(&apos;minute&apos;, &#13;&#10;//                   (INT(DATEPART(&apos;minute&apos;, NOW()) / 15)) * 15, &#13;&#10;//                   DATETRUNC(&apos;hour&apos;, now()) )&#13;&#10;//           )&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 3 ***: &#13;&#10;// Don&apos;t want alerts except during business hours? Add that into your condition:&#13;&#10;// Example:&#13;&#10;//    (DATEPART(&apos;hour&apos;, NOW()) &gt; 8 AND DATEPART(&apos;hour&apos;, NOW()) &lt; 18 // work hours&#13;&#10;//        AND (&#13;&#10;//            // work days&#13;&#10;//            DATENAME(&apos;weekday&apos;, TODAY()) = &apos;Monday&apos; OR&#13;&#10;//            DATENAME(&apos;weekday&apos;, TODAY()) = &apos;Tuesday&apos; OR&#13;&#10;//            DATENAME(&apos;weekday&apos;, TODAY()) = &apos;Wednesday&apos; OR&#13;&#10;//            DATENAME(&apos;weekday&apos;, TODAY()) = &apos;Thursday&apos; OR&#13;&#10;//            DATENAME(&apos;weekday&apos;, TODAY()) = &apos;Friday&apos;&#13;&#10;//            )&#13;&#10;//    )' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>This field defines the criteria for when an email should be sent.</run>
                  <run bold='true'>Æ&#10;</run>
                  <run>
When set to a value of 1, this field indicates that the action for </run>
                  <run bold='true'>whatever row it&apos;s found in</run>
                  <run> is to send an </run>
                  <run bold='true'>email</run>
                  <run>. Values other than &quot;1&quot; will result in </run>
                  <run italic='true'>no</run>
                  <run> email actions being taken. Edit the calculation for usage examples.</run>
                  <run bold='true'>&#10;&#10;Required for any Email action</run>
                </formatted-text>
              </desc>
            </column>
            <column caption=' Email From' datatype='string' name='[Calculation_5020330152519186 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;vhe.tableau@celcomdigi.com&apos;' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Email address that the email will be sent from.
</run>
                  <run bold='true'>
If not provided, the default email address set by the Admin will be used.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption=' Email To' datatype='string' name='[Calculation_5020330152519186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Text string representing the email address(es) you want to send email to.&#13;&#10;//      Can be single addresses, or semicolon, comma, or space delimited&#13;&#10;&#13;&#10;// Default value is empty, which will cause VizAlerts To error. So edit and supply your own, e.g. &apos;youremail@yourcompany.com&apos;:&#13;&#10;&apos;wj_wong@unifiedcomms.com&apos;&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 1 ***: &#13;&#10;// Send email dynamically to different people based on your data!&#13;&#10;//&#13;&#10;// Example 1: Email different combinations of address based on sales amount&#13;&#10;//    IF SUM([Sales]) &gt; 1000 AND SUM([Sales]) &lt; 10000 THEN &apos;salesmanagers@mycompany.com;me@mycompany.com&apos; // decent-sized deal; email the sales managers and myself&#13;&#10;//    ELSEIF SUM([Sales]) &gt; 10000 THEN &apos;ceo@ourcompany.com;salesmanagers@mycompany.com;me@mycompany.com&apos; // big deal! Email the ceo too!&#13;&#10;//    ELSE &apos;me@mycompany.com&apos; // no big deal, just email me&#13;&#10;//    END&#13;&#10;//&#13;&#10;// Example 2: Email whoever the salesperson on the account is&#13;&#10;//    [Salesperson Email]  // A field in your data that has the email address for the salesperson...simple as that!&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;// *** TIP 2 ***: &#13;&#10;// Use a Parameter to create a &quot;Test Mode&quot; for your alert&#13;&#10;//&#13;&#10;// Example:&#13;&#10;//      IF [Test Mode] THEN &apos;me@mycompany.com&apos;   // When the param is set to &quot;true&quot; , only email me.&#13;&#10;//      ELSE [Salesperson Email]                 // When it&apos;s &quot;false&quot;, go ahead and email the salespeople &#13;&#10;//      END' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Email address(es) that the email will be sent to, delimited by commas, semicolons, or space characters.</run>
                  <run bold='true'>

If not provided, a the email address of the Subscriber to the VizAlert will be used.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption=' Email Attachment' datatype='string' name='[Calculation_8420401154520687 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attachments are appended to the end of the mail. &#13;&#10;// The following content references are supported:&#13;&#10;//    VIZ_IMAGE() - PNG&#13;&#10;//    VIZ_PDF() - PDF&#13;&#10;//    VIZ_CSV() - CSV&#13;&#10;&#13;&#10;&quot;VIZ_PDF(|filename=kpi_alert_&quot;&#13;&#10;+ STR(DATEPART(&apos;year&apos;, NOW())) &#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, NOW())), 2) &#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, NOW())), 2) &#13;&#10;+ &quot;_&quot; &#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, NOW())), 2) &#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, NOW())), 2) &#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;second&apos;, NOW())), 2)&#13;&#10;+ &quot;)&quot;' scope-isolation='false' />
              <desc>
                <formatted-text>
                  <run>Attachments are appended to the end of the mail. 
The following attachments are supported
    VIZ_IMAGE() - PNG
    VIZ_PDF() - PDF
    VIZ_CSV() - CSV

Multiple attachment references can be made in this field

These can take an argument myWorkbook/myView and URL parameters as per http://kb.tableau.com/articles/knowledgebase/view-filters-url. For example VIZ_CSV(mySalesReport/myDashboard?SalesPerson=Johnna
</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='integer' name='[alert_cnt]' role='measure' type='quantitative' />
