        <relation type='collection'>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query' type='text'><![CDATA[--alert trend
SELECT
    tx_datetime,
    CASE
        severity
        WHEN 1 THEN 'Info'
        WHEN 2 THEN 'Warning'
        WHEN 4 THEN 'High'
        ELSE ''
    END AS severity_grp,
    severity,
    COUNT(DISTINCT threshold_id) AS trend_cnt
FROM (
        SELECT a.threshold_id,
            tx_datetime,
            severity,
            CASE
                metric_rat
                WHEN '2G' THEN 'GSM (1001)'
                WHEN '3G' THEN 'UMTS (1000)'
                WHEN '4G' THEN 'LTE (1004)'
                WHEN '5GNSA' THEN 'NSA (3000)'
                WHEN 'ALL' THEN '-'
                ELSE ''
            END AS rat
        FROM roam352_report.alert_kpi a
            LEFT JOIN roam352_report.thresholds t ON a.threshold_id = t.threshold_id
        WHERE t.status = 1
            AND a.status = 1 
            AND (
                comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
                OR '-999' = <[Parameters].[Parameter 6]>
            )
            AND (
                comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
                OR '-999' = <[Parameters].[Parameter 8]>
            )
            AND (
                metric = <[Parameters].[Parameter 7]>
                OR '(All)' = <[Parameters].[Parameter 7]>
            )
            AND par_date BETWEEN CAST(
                REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
            )
            AND CAST(
                REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
            )
            AND (
                severity = <[Parameters].[Parameter 1]>
                OR -999 = <[Parameters].[Parameter 1]>
            )
    ) tbl
WHERE (
        tbl.rat = <[Parameters].[Parameter 5]>
        OR '(All)' = <[Parameters].[Parameter 5]>
    )
GROUP BY 
    tx_datetime,
    severity_grp,
    severity]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query9' type='text'><![CDATA[--pie - all threshold
WITH threshold AS (
    SELECT threshold_id,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        severity,
        1 AS data_set,
        status
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        severity,
        2 AS data_set,
        status
    FROM roam352_report.vip_thresholds
    WHERE status = 1
)
SELECT comparison_subject_mcc_ref,
    comparison_subject_mnc_ref,
    severity,
    CASE
        severity
        WHEN 1 THEN 'Info'
        WHEN 2 THEN 'Warning'
        WHEN 3 THEN 'Average'
        WHEN 4 THEN 'High'
        WHEN 5 THEN 'Disaster'
        ELSE ''
    END AS severity_grp,
    COUNT(1) AS total_thresh
FROM threshold
WHERE (
        '(All)' = <[Parameters].[Parameter 27]>
        OR kpi_threshold_name = <[Parameters].[Parameter 27]>
    )
    AND (
        -999 = <[Parameters].[Parameter 15]>
        OR data_set = <[Parameters].[Parameter 15]>
    )
    AND (
        -999 = <[Parameters].[Parameter 1]>
        OR severity = <[Parameters].[Parameter 1]>
    )
    AND (
        '-999' = <[Parameters].[Parameter 6]>
        OR comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
    )
    AND (
        '-999' = <[Parameters].[Parameter 8]>
        OR comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
    )
    AND (
        '(All)' = <[Parameters].[Parameter 7]>
        OR metric = <[Parameters].[Parameter 7]>
    )
    AND (
        '(All)' = <[Parameters].[Parameter 5]>
        OR rat = <[Parameters].[Parameter 5]>
    )
GROUP BY comparison_subject_mcc_ref,
    comparison_subject_mnc_ref,
    severity]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query10' type='text'><![CDATA[--pie - has alert/no alert
WITH threshold AS (
    SELECT threshold_id,
        kpi_threshold_name,
        NULL AS imsi,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        severity,
        1 AS data_set,
        status
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        kpi_threshold_name,
        imsi,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        severity,
        2 AS data_set,
        status
    FROM roam352_report.vip_thresholds
    WHERE status = 1
),
alert AS (
    SELECT threshold_id,
        IF(max_dt != FROM_UNIXTIME(UNIX_TIMESTAMP()), 'Resolved', 'Problem') AS resolve_status
    FROM (
    SELECT threshold_id,
        MAX(tx_datetime) AS max_dt
    FROM roam352_report.alert_kpi
    WHERE par_date BETWEEN CAST(
            REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
        )
        AND CAST(
            REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
        )
    GROUP BY threshold_id)tbl
)
SELECT 
    IF(a.threshold_id IS NOT NULL, 'Has Alert', '') AS trigger_status,
    COUNT(1) AS trigger_cnt
FROM threshold t
    LEFT JOIN alert a ON t.threshold_id = a.threshold_id
    WHERE (
        '(All)' = <[Parameters].[Parameter 27]>
        OR kpi_threshold_name = <[Parameters].[Parameter 27]>
    )
    AND (
        -999 = <[Parameters].[Parameter 15]>
        OR t.data_set = <[Parameters].[Parameter 15]>
    )
    AND (
        -999 = <[Parameters].[Parameter 1]>
        OR severity = <[Parameters].[Parameter 1]>
    )
    AND (
        '-999' = <[Parameters].[Parameter 6]>
        OR t.comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
    )
    AND (
        '-999' = <[Parameters].[Parameter 8]>
        OR t.comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
    )
    AND (
        '(All)' = <[Parameters].[Parameter 7]>
        OR metric = <[Parameters].[Parameter 7]>
    )
    AND (
        '(All)' = <[Parameters].[Parameter 5]>
        OR t.rat = <[Parameters].[Parameter 5]>
    )
GROUP BY 
    trigger_status]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query5' type='text'><![CDATA[--summary
WITH threshold AS (
    SELECT threshold_id,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        severity,
        CASE
            severity
            WHEN 1 THEN 'Info'
            WHEN 2 THEN 'Warning'
            WHEN 3 THEN 'Average'
            WHEN 4 THEN 'High'
            WHEN 5 THEN 'Disaster'
            ELSE ''
        END AS severity_grp,
        1 AS data_set,
        status
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        severity,
        CASE
            severity
            WHEN 1 THEN 'Info'
            WHEN 2 THEN 'Warning'
            WHEN 3 THEN 'Average'
            WHEN 4 THEN 'High'
            WHEN 5 THEN 'Disaster'
            ELSE ''
        END AS severity_grp,
        2 AS data_set,
        status
    FROM roam352_report.vip_thresholds
    WHERE status = 1
),
alert AS (
    SELECT DISTINCT threshold_id
    FROM roam352_report.alert_kpi
    WHERE par_date BETWEEN CAST(
            REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
        )
        AND CAST(
            REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
        )
        -- AND(
        --     -999 = <[Parameters].[Parameter 15]>
        --     OR data_set = <[Parameters].[Parameter 15]>
        -- )
),
agg AS (
    SELECT SUM(
            CASE
                WHEN t.data_set = 1 THEN 1
                ELSE 0
            END
        ) AS norm_thresh,
        SUM(
            CASE
                WHEN t.data_set = 2 THEN 1
                ELSE 0
            END
        ) AS vip_thresh,
        SUM(
            CASE
                WHEN a.threshold_id IS NOT NULL THEN 1
                ELSE 0
            END
        ) AS has_alert,
        SUM(
            CASE
                WHEN a.threshold_id IS NULL THEN 1
                ELSE 0
            END
        ) AS no_alert,
        SUM(
            CASE
                WHEN severity = 1 THEN 1
                ELSE 0
            END
        ) AS sev_info,
        SUM(
            CASE
                WHEN severity = 2 THEN 1
                ELSE 0
            END
        ) AS sev_warn,
        SUM(
            CASE
                WHEN severity = 3 THEN 1
                ELSE 0
            END
        ) AS sev_avg,
        SUM(
            CASE
                WHEN severity = 4 THEN 1
                ELSE 0
            END
        ) AS sev_high,
        SUM(
            CASE
                WHEN severity = 5 THEN 1
                ELSE 0
            END
        ) AS sev_disaster
    FROM threshold t
        LEFT JOIN alert a ON t.threshold_id = a.threshold_id
    WHERE (
            '(All)' = <[Parameters].[Parameter 27]>
            OR kpi_threshold_name = <[Parameters].[Parameter 27]>
        )
        AND (
            -999 = <[Parameters].[Parameter 1]>
            OR severity = <[Parameters].[Parameter 1]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 6]>
            OR comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 8]>
            OR comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 7]>
            OR metric = <[Parameters].[Parameter 7]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 5]>
            OR rat = <[Parameters].[Parameter 5]>
        )
        AND (
            -999 = <[Parameters].[Parameter 15]>
            OR t.data_set = <[Parameters].[Parameter 15]>
        )
)
SELECT 
    CONCAT_WS('\n\n',
        CONCAT('Normal: ', CAST(norm_thresh AS STRING), ' '),
        CONCAT('VIP: ', CAST(vip_thresh AS STRING), ' ')
    ) AS threshold_type,
    CONCAT_WS('\n\n',
        CONCAT('Has Alert: ', CAST(has_alert AS STRING), ' '),
        CONCAT('No Alert: ', CAST(no_alert AS STRING), ' ')
    ) AS alert_presence,
    CONCAT_WS(
        '\n\n',
        IF(
            sev_info>> 0,
            CONCAT('Info: ', CAST(sev_info AS STRING), ' '),
            NULL
        ),
        IF(
            sev_warn>> 0,
            CONCAT('Warning: ', CAST(sev_warn AS STRING), ' '),
            NULL
        ),
        IF(
            sev_avg>> 0,
            CONCAT('Average: ', CAST(sev_avg AS STRING), ' '),
            NULL
        ),
        IF(
            sev_high>> 0,
            CONCAT('High: ', CAST(sev_high AS STRING), ' '),
            NULL
        ),
        IF(
            sev_disaster>> 0,
            CONCAT('Disaster: ', CAST(sev_disaster AS STRING)),
            NULL
        )
    ) AS severity_breakdown
FROM agg]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query4' type='text'><![CDATA[--alert count
WITH threshold AS (
    SELECT threshold_id,
        NULL AS imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        metric_duration_value,
        metric_duration_unit,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        1 AS data_set
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN 'NSA (3000)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        metric_duration_value,
        metric_duration_unit,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        2 AS data_set
    FROM roam352_report.vip_thresholds
    WHERE status = 1
),
alert AS (
    SELECT MAX(tx_datetime) AS overall_max_dt
    FROM roam352_report.alert_kpi a
        INNER JOIN threshold t ON a.threshold_id = t.threshold_id
        AND a.data_set = t.data_set
    WHERE a.status = 1
        AND par_date BETWEEN CAST(
            REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
        )
        AND CAST(
            REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
        )
        AND (
            -999 = <[Parameters].[Parameter 15]>
            OR a.data_set = <[Parameters].[Parameter 15]>
        )
        AND (
            -999 = <[Parameters].[Parameter 1]>
            OR severity = <[Parameters].[Parameter 1]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 6]>
            OR comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 8]>
            OR comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 7]>
            OR metric = <[Parameters].[Parameter 7]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 27]>
            OR kpi_threshold_name = <[Parameters].[Parameter 27]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 5]>
            OR rat = <[Parameters].[Parameter 5]>
        )
)
SELECT CAST(
        FLOOR(
            (
                UNIX_TIMESTAMP(overall_max_dt) - UNIX_TIMESTAMP(
                    CAST(<[Parameters].[Parameter 9]> AS TIMESTAMP)
                )
            ) / 300
        ) + 1 AS INT
    ) AS total_alert_cnt
FROM alert]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query2' type='text'>--kpi&#13;
WITH threshold AS (&#13;
    SELECT threshold_id,&#13;
        kpi_threshold_name,&#13;
        metric,&#13;
        1 AS data_set&#13;
    FROM roam352_report.thresholds&#13;
    WHERE status = 1&#13;
    UNION ALL&#13;
    SELECT threshold_id,&#13;
        kpi_threshold_name,&#13;
        metric,&#13;
        2 AS data_set&#13;
    FROM roam352_report.vip_thresholds&#13;
    WHERE status = 1&#13;
)&#13;
SELECT DISTINCT metric&#13;
FROM threshold&#13;
UNION ALL&#13;
SELECT &apos;(All)&apos; AS metric</relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query12' type='text'>--kpi name&#13;
WITH threshold AS (&#13;
    SELECT threshold_id,&#13;
        kpi_threshold_name,&#13;
        metric,&#13;
        1 AS data_set,&#13;
        3 AS rn&#13;
    FROM roam352_report.thresholds&#13;
    WHERE status = 1&#13;
    UNION ALL&#13;
    SELECT threshold_id,&#13;
        kpi_threshold_name,&#13;
        metric,&#13;
        2 AS data_set,&#13;
        2 AS rn&#13;
    FROM roam352_report.vip_thresholds&#13;
    WHERE status = 1&#13;
)&#13;
SELECT DISTINCT rn,&#13;
    threshold_id,&#13;
    IF(&#13;
        data_set = 2,&#13;
        CONCAT(&apos;(VIP) &apos;, kpi_threshold_name),&#13;
        kpi_threshold_name&#13;
    ) AS kpi_threshold_name&#13;
FROM threshold&#13;
UNION ALL&#13;
SELECT 1 AS rn,&#13;
    -999 AS threshold_id,&#13;
    &apos;(All)&apos; AS kpi_threshold_name&#13;
ORDER BY rn</relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query3' type='text'><![CDATA[-- details
WITH threshold AS (
    SELECT threshold_id,
        NULL AS imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        operator,
        comparison_type,
        status,
        severity,
        1 AS data_set
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        operator,
        comparison_type,
        status,
        severity,
        2 AS data_set
    FROM roam352_report.vip_thresholds
    WHERE status = 1
),
alert AS (
    SELECT *,
        SUM(prob_start) OVER (
            PARTITION BY threshold_id
            ORDER BY tx_datetime ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS sess_id
    FROM(
            SELECT tbl.*,
                IF(
                    five_min_bfr != prev_dt
                    OR prev_dt IS NULL,
                    1,
                    0
                ) AS prob_start,
                MAX(tx_datetime) OVER (PARTITION BY threshold_id) AS max_dt_sess
            FROM (
                    SELECT tx_datetime,
                        a.threshold_id,
                        kpi_threshold_name,
                        metric,
                        metric_duration_unit,
                        comparison_subject_mcc_ref,
                        comparison_subject_mnc_ref,
                        comparison_type,
                        t.imsi,
                        CAST(tx_datetime AS TIMESTAMP) - INTERVAL 5 MINUTES AS five_min_bfr,
                        LAG(tx_datetime) OVER (
                            PARTITION BY a.threshold_id
                            ORDER BY tx_datetime
                        ) AS prev_dt,
                        LAG(a.threshold_id) OVER (
                            ORDER BY a.threshold_id
                        ) AS prev_t_id,
                        metric_rat,
                        severity,
                        metric_duration_value,
                        a.data_set,
                        tx_value,
                        operator,
                        threshold_value
                    FROM roam352_report.alert_kpi a
                        INNER JOIN threshold t ON a.threshold_id = t.threshold_id
                        AND a.data_set = t.data_set
                       WHERE a.status = 1
                        AND par_date BETWEEN CAST(
                            REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
                        )
                        AND CAST(
                            REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
                        )
                        AND (
                            -999 = <[Parameters].[Parameter 21]>
                            OR a.threshold_id = <[Parameters].[Parameter 21]>
                        )
                        AND (
                            -999 = <[Parameters].[Parameter 15]>
                            OR a.data_set = <[Parameters].[Parameter 15]>
                        )
                        AND (
                            -999 = <[Parameters].[Parameter 1]>
                            OR severity = <[Parameters].[Parameter 1]>
                        )
                        AND (
                            '-999' = <[Parameters].[Parameter 6]>
                            OR comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
                        )
                        AND (
                            '-999' = <[Parameters].[Parameter 8]>
                            OR comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
                        )
                        AND (
                            '(All)' = <[Parameters].[Parameter 7]>
                            OR metric = <[Parameters].[Parameter 7]>
                        )
                        AND (
                            -999 = <[Parameters].[Parameter 22]>
                            OR a.threshold_id = <[Parameters].[Parameter 22]>
                        )
                        AND (
                            '(All)' = <[Parameters].[Parameter 27]>
                            OR kpi_threshold_name = <[Parameters].[Parameter 27]>
                        )
                        AND (
                            (
                                '9999-01-01 00:00:00' = <[Parameters].[Parameter 23]>
                            )
                            OR (
                                '9999-01-01 00:00:00' = <[Parameters].[Parameter 24]>
                            )
                            OR (
                                (CAST(tx_datetime AS TIMESTAMP)) BETWEEN CAST(<[Parameters].[Parameter 23]> AS TIMESTAMP)
                                AND CAST(<[Parameters].[Parameter 24]> AS TIMESTAMP)
                            )
                        )
                ) tbl
        ) tbl
)
SELECT threshold_id,
    kpi_threshold_name,
    comparison_subject_mcc_ref,
    comparison_subject_mnc_ref,
    country_name,
    operator_name,
    initial_dt,
    CAST(initial_val AS DECIMAL(12, 2)) AS initial_val,
    CASE
        severity
        WHEN 1 THEN 'Info'
        WHEN 2 THEN 'Warning'
        WHEN 3 THEN 'Average'
        WHEN 4 THEN 'High'
        WHEN 5 THEN 'Disaster'
        ELSE ''
    END AS severity_grp,
    IF(
        data_set = 1,
        CONCAT(
            CAST(metric AS STRING),
            ' ',
            comparison_type,
            ' - RAT: ',
            metric_rat,
            ', Country: ',
            IFNULL(country_name, 'All'),
            ' (',
            CAST(comparison_subject_mcc_ref AS STRING),
            ')',
            ', Operator: ',
            IF(
                CAST(comparison_subject_mnc_ref AS STRING) = '-1',
                'All',
                IFNULL(operator_name, '-')
            ),
            ' (',
            CAST(comparison_subject_mnc_ref AS STRING),
            ')',
            ', Sum of Duration: ',
            CAST(metric_duration_value AS STRING),
            LEFT(metric_duration_unit, 1),
            ', Threshold Value: ',
            CAST(operator AS STRING),
            CAST(threshold_value AS STRING)
        ),
        CONCAT(
            CAST(metric AS STRING),
            ' ',
            comparison_type,
            ' - RAT: ',
            metric_rat,
            ', IMSI: ',
            imsi,
            ', Sum of Duration: ',
            CAST(metric_duration_value AS STRING),
            LEFT(metric_duration_unit, 1),
            ', Threshold Value: ',
            CAST(operator AS STRING),
            CAST(threshold_value AS STRING)
        )
    ) AS details,
    metric,
    severity,
    CONCAT(
        CAST(threshold_id AS STRING),
        '-',
        CAST(sess_id AS STRING)
    ) AS sess,
    DENSE_RANK() OVER (
        ORDER BY max_dt DESC,
            threshold_id,
            sess_id DESC
    ) AS rn
FROM(
        SELECT threshold_id,
            kpi_threshold_name,
            tx_datetime AS initial_dt,
            tx_value AS initial_val,
            metric,
            comparison_subject_mcc_ref,
            comparison_subject_mnc_ref,
            metric_duration_value,
            metric_duration_unit,
            IF(
                comparison_type = 'compare_to_threshold',
                '(Threshold)',
                comparison_type
            ) AS comparison_type,
            operator,
            threshold_value,
            severity,
            REPLACE(
                metric_rat,
                'ALL',
                'All'
            ) AS metric_rat,
            CASE
                metric_rat
                WHEN '2G' THEN 'GSM (1001)'
                WHEN '3G' THEN 'UMTS (1000)'
                WHEN '4G' THEN 'LTE (1004)'
                WHEN '5GNSA' THEN 'NSA (3000)'
                WHEN 'ALL' THEN '-'
                ELSE ''
            END AS rat,
            a.data_set,
            CAST(imsi AS STRING) AS imsi,
            sess_id,
            MAX(tx_datetime) OVER (PARTITION BY threshold_id, sess_id) AS max_dt
        FROM alert a
    ) tbl
    LEFT JOIN roam352_report.sys_country_profile cty ON CAST(tbl.comparison_subject_mcc_ref AS INT) = cty.mcc_ref
    LEFT JOIN roam352_report.sys_operator_profile op ON CAST(tbl.comparison_subject_mcc_ref AS INT) = op.mcc
    AND tbl.comparison_subject_mnc_ref = op.mnc
WHERE (
        '(All)' = <[Parameters].[Parameter 5]>
        OR tbl.rat = <[Parameters].[Parameter 5]>
    )]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query6' type='text'>--rat&#13;
SELECT rat_type,&#13;
    rat_name,&#13;
    CONCAT(rat_name, &apos; (&apos;, CAST(rat_type AS STRING), &apos;)&apos;) AS rat_name_type&#13;
FROM roam352_report.repdata_rat&#13;
WHERE usm_sub_id = 1272&#13;
    AND rat_type IN (1000, 1001, 1004, 3000)&#13;
ORDER BY seq_id&#13;
UNION ALL&#13;
SELECT -999 AS rat_type,&#13;
    &apos;(All)&apos; AS rat_name,&#13;
    &apos;(All)&apos; AS rat_name_type&#13;
UNION ALL&#13;
SELECT -1 AS rat_type,&#13;
    &apos;-&apos; AS rat_name,&#13;
    &apos;-&apos; AS rat_name_type</relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query1' type='text'>-- cty op&#13;
SELECT comparison_subject_mcc_ref,&#13;
    comparison_subject_mnc_ref,&#13;
    IFNULL(CONCAT(country_name, &apos; (&apos;, CAST(cty.mcc_ref AS STRING), &apos;)&apos;), &apos;-&apos;) AS cty_mcc,&#13;
    IF(comparison_subject_mnc_ref = &apos;-1&apos;, &apos;-&apos;, CONCAT(operator_name, &apos; (&apos;, mnc_ref, &apos;)&apos;)) AS op_mnc&#13;
FROM roam352_report.thresholds t&#13;
    LEFT JOIN roam352_report.sys_country_profile cty ON CAST(t.comparison_subject_mcc_ref AS INT) = cty.mcc_ref&#13;
    LEFT JOIN roam352_report.sys_operator_profile op ON CAST(t.comparison_subject_mcc_ref AS INT) = op.mcc_ref AND&#13;
    t.comparison_subject_mnc_ref = op.mnc_ref&#13;
    WHERE status = 1&#13;
UNION ALL&#13;
SELECT &apos;-999&apos; AS comparison_subject_mcc_ref,&#13;
&apos;-999&apos; AS comparison_subject_mnc_ref,&#13;
&apos;(All)&apos; AS cty_mcc,&#13;
&apos;(All)&apos; AS op_mnc</relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query8' type='text'><![CDATA[--trend
WITH threshold AS (
    SELECT threshold_id,
        NULL AS imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        1 AS data_set
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        2 AS data_set
    FROM roam352_report.vip_thresholds
    WHERE status = 1
),
alert AS (
    SELECT tx_datetime,
        a.threshold_id,
        kpi_threshold_name,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        CAST(tx_datetime AS TIMESTAMP) - INTERVAL 5 MINUTES AS five_min_bfr,
        LAG(tx_datetime) OVER (
            PARTITION BY a.threshold_id
            ORDER BY tx_datetime
        ) AS prev_dt,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN '5G NSA (1004)'
            WHEN '5G' THEN '5G (1006)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        severity,
        metric_duration_value,
        a.data_set,
        tx_value,
        metric,
        comparison_type,
        operator,
        threshold_value,
        imsi,
        metric_duration_unit,
        MAX(tx_datetime) OVER (PARTITION BY a.threshold_id) AS max_dt,
        MIN(tx_datetime) OVER (PARTITION BY a.threshold_id) AS min_dt,
        COUNT(tx_datetime) OVER (PARTITION BY a.threshold_id) AS alert_cnt,
        MAX(tx_datetime) OVER () AS overall_max_dt,
        MAX(CAST(tx_value AS DECIMAL(10, 2))) OVER () max_value
    FROM roam352_report.alert_kpi a
        INNER JOIN threshold t ON a.threshold_id = t.threshold_id
        AND a.data_set = t.data_set
    WHERE a.status = 1
        AND par_date BETWEEN CAST(
            REPLACE(<[Parameters].[Parameter 9]>, '-', '') AS INTEGER
        )
        AND CAST(
            REPLACE(<[Parameters].[Parameter 10]>, '-', '') AS INTEGER
        )
        AND (
            -999 = <[Parameters].[Parameter 15]>
            OR a.data_set = <[Parameters].[Parameter 15]>
        )
        AND (
            -999 = <[Parameters].[Parameter 1]>
            OR severity = <[Parameters].[Parameter 1]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 6]>
            OR t.comparison_subject_mcc_ref = <[Parameters].[Parameter 6]>
        )
        AND (
            '-999' = <[Parameters].[Parameter 8]>
            OR t.comparison_subject_mnc_ref = <[Parameters].[Parameter 8]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 7]>
            OR t.metric = <[Parameters].[Parameter 7]>
        )
        AND (
            '(All)' = <[Parameters].[Parameter 27]>
            OR kpi_threshold_name = <[Parameters].[Parameter 27]>
        )
),
sess_alert AS (
    SELECT comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        threshold_id,
        kpi_threshold_name,
        prob_id,
        tx_datetime,
        severity,
        rat,
        metric_duration_value,
        alert_cnt,
        overall_max_dt,
        tx_value,
        max_value,
        metric,
        metric_duration_unit,
        data_set,
        IF(
            comparison_type = 'compare_to_threshold',
            '(Threshold)',
            comparison_type
        ) AS comparison_type,
        operator,
        threshold_value,
        imsi,
        MIN(tx_datetime) OVER (PARTITION BY threshold_id, prob_id) AS start_dt,
        MAX(tx_datetime) OVER (PARTITION BY threshold_id, prob_id) AS end_dt
    FROM(
            SELECT *,
                SUM(prob_start) OVER (
                    PARTITION BY threshold_id
                    ORDER BY tx_datetime ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                ) AS prob_id
            FROM (
                    SELECT *,
                        IF(five_min_bfr != prev_dt, 1, 0) AS prob_start
                    FROM alert
                    WHERE (
                            '(All)' = <[Parameters].[Parameter 5]>
                            OR rat = <[Parameters].[Parameter 5]>
                        )
                ) tbl
        ) tbl
)
SELECT threshold_id,
    kpi_threshold_name,
    prob_id,
    CAST(tx_datetime AS TIMESTAMP) AS tx_datetime,
    CAST(start_dt AS TIMESTAMP) AS start_dt,
    CAST(end_dt AS TIMESTAMP) AS end_dt,
    severity,
    CASE
        severity
        WHEN 1 THEN 'Info'
        WHEN 2 THEN 'Warning'
        WHEN 3 THEN 'Average'
        WHEN 4 THEN 'High'
        WHEN 5 THEN 'Disaster'
        ELSE ''
    END AS severity_grp,
    metric_duration_value,
    rat,
    alert_cnt,
    overall_max_dt,
    tx_value,
    max_value,
    CAST(
        (
            UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)
        ) / 60 AS INT
    ) AS duration_min2,
    CASE
    WHEN (
        (UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)) / 60
    ) << 60 THEN
        CONCAT(
            CAST((UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)) / 60 AS STRING),
            ' min'
        )

    WHEN (
        (UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)) / 60
    ) << 1440 THEN
        CONCAT(
            CAST(
                ROUND((UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)) / 3600.0, 2)
                AS STRING
            ),
            ' hr'
        )

    ELSE
        CONCAT(
            CAST(
                FLOOR((UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)) / 86400) AS STRING
            ),
            ' day ',
            CAST(
                FLOOR(
                    MOD((UNIX_TIMESTAMP(end_dt) - UNIX_TIMESTAMP(start_dt)), 86400) / 3600
                ) AS STRING
            ),
            ' hr'
        )
    END AS duration_min,IF(
    data_set = 1,
    CONCAT(
        CAST(metric AS STRING),
        ' ',
        comparison_type,
        ' - RAT: ',
        IF(rat = '-', '(All)', RAT),
        ', Country: ',
        IFNULL(country_name, 'All'),
        ' (',
        CAST(comparison_subject_mcc_ref AS STRING),
        ')',
        ', Operator: ',
        IF(
            CAST(comparison_subject_mnc_ref AS STRING) = '-1',
            'All',
            IFNULL(operator_name, '-')
        ),
        ' (',
        CAST(comparison_subject_mnc_ref AS STRING),
        ')',
        ', Sum of Duration: ',
        CAST(metric_duration_value AS STRING),
        LEFT(metric_duration_unit, 1),
        ', Threshold Value: ',
        CAST(operator AS STRING),
        CAST(threshold_value AS STRING)
    ),
    CONCAT(
        CAST(metric AS STRING),
        ' ',
        comparison_type,
        ' - RAT: ',
        IF(rat = '-', '(All)', RAT),
        ', IMSI: ',
        CAST(imsi AS STRING),
        ', Sum of Duration: ',
        CAST(metric_duration_value AS STRING),
        LEFT(metric_duration_unit, 1),
        ', Threshold Value: ',
        CAST(operator AS STRING),
        CAST(threshold_value AS STRING)
    )
) AS details
FROM sess_alert
    LEFT JOIN roam352_report.sys_country_profile cty ON CAST(comparison_subject_mcc_ref AS INT) = cty.mcc_ref
    LEFT JOIN roam352_report.sys_operator_profile op ON CAST(comparison_subject_mcc_ref AS INT) = op.mcc
    AND comparison_subject_mnc_ref = op.mnc]]></relation>
          <relation connection='impala.0vf90r01ys5d4119i8ejl0k7c6yd' name='Custom SQL Query7' type='text'><![CDATA[--trend
WITH threshold AS (
    SELECT threshold_id,
        NULL AS imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        1 AS data_set
    FROM roam352_report.thresholds
    WHERE status = 1
    UNION ALL
    SELECT threshold_id,
        imsi,
        threshold_value,
        kpi_threshold_name,
        metric,
        metric_rat,
        metric_duration_value,
        metric_duration_unit,
        NULL AS comparison_subject_mcc_ref,
        '' AS comparison_subject_mnc_ref,
        operator,
        comparison_type,
        severity,
        2 AS data_set
    FROM roam352_report.vip_thresholds
    WHERE status = 1
)

SELECT tbl.*,
    CONCAT('http://10.244.138.8/#/views/KPIAlert/AlertsOverview?input_kpi=', 
    url_kpi, '&input_rat=', url_rat, '&cty_mcc=', 
    IFNULL(CONCAT(country_name, '%20(', CAST(comparison_subject_mcc_ref AS STRING), ')'), 'All'), 
    '&op_mnc=', 
    IF(CAST(comparison_subject_mnc_ref AS STRING) = '-1', 'All', 
        CONCAT(operator_name,'%20(',CAST(comparison_subject_mnc_ref AS STRING),')')), 
    '&input_data_set=', url_data_set, '&param_kpi=', url_kpi, '&param_rat=', url_rat, 
    '&param_data_set=', url_data_set, '&input_kpi_name=', url_kpi_threshold_name, 
    '&param_kpi_name=', url_kpi_threshold_name) AS url,
    IF(
        tbl.data_set = 1,
        CONCAT(
            'KPI: ', '\n',
            'Threshold Value: ', '\n',
            'RAT: ', '\n',
            '\n',
            'Country: ', '\n',
            'Operator: ', '\n',
            'Last Alert Session: '
        ),
        CONCAT(
            'KPI: ', '\n',
            'Threshold Value: ', '\n',
            'RAT: ', '\n',
            '\n',
            'IMSI: '
        )
    ) AS details_title,
    IF(
        tbl.data_set = 1,
        CONCAT(
            CAST(metric AS STRING), ' ', comparison_type, '\n',
            CAST(operator AS STRING), CAST(threshold_value AS STRING), ' of ', CAST(metric_duration_value AS STRING), LEFT(metric_duration_unit, 1), '\n',
            IF(rat = '-', '(All)', RAT), '\n',
            '\n',
            IFNULL(country_name, 'All'), ' (', CAST(comparison_subject_mcc_ref AS STRING), ')', '\n',
            IF(CAST(comparison_subject_mnc_ref AS STRING) = '-1','All',IFNULL(operator_name, '-')),' (',CAST(comparison_subject_mnc_ref AS STRING),')', '\n',
            CAST(max_start_dt AS STRING), ' - ', CAST(max_end_dt AS STRING), ' (',
                MAX(IF(max_start_dt = start_dt AND max_end_dt = end_dt, duration_min, '')) OVER (PARTITION BY threshold_id), ')'
        ),
        CONCAT(
            CAST(metric AS STRING), ' ', comparison_type, '\n',
            CAST(operator AS STRING), CAST(threshold_value AS STRING), ' of ', CAST(metric_duration_value AS STRING), LEFT(metric_duration_unit, 1), '\n',
            IF(rat = '-', '(All)', RAT), '\n',
            '\n',
            CAST(imsi AS STRING)
        )
    ) AS details
FROM (
    SELECT
        1 as alert_trigger,
        tbl.threshold_id,
        tbl.tx_datetime,
        tbl.data_set,
        status,
        CASE group_id
            WHEN 1 THEN 'New'
            WHEN 2 THEN 'Existing'
            WHEN 3 THEN 'Resolved'
            ELSE 'Unknown'
        END AS alert_status,
        new_cnt,
        new_cnt_vip,
        existing_cnt,
        existing_cnt_vip,
        resolved_cnt,
        resolved_cnt_vip,
        start_dt,
        MAX(start_dt) OVER (PARTITION BY tbl.threshold_id) AS max_start_dt,
        end_dt,
        MAX(end_dt) OVER (PARTITION BY tbl.threshold_id) AS max_end_dt,
        CASE
            WHEN (duration_sec / 60) << 60 
                THEN CONCAT(CAST(ROUND(duration_sec / 60.0, 2) AS STRING), ' min(s)')
            WHEN (duration_sec / 60) << 1440 
                THEN CONCAT(CAST(ROUND(duration_sec / 3600.0, 2) AS STRING), ' hr(s)')
        ELSE
            CASE
                WHEN FLOOR(MOD(duration_sec, 86400) / 3600) = 0 
                    THEN CONCAT(CAST(FLOOR(duration_sec / 86400) AS STRING), ' day(s)')
            ELSE
                CONCAT(CAST(FLOOR(duration_sec / 86400) AS STRING), ' day(s) ', CAST(FLOOR(MOD(duration_sec, 86400) / 3600) AS STRING), ' hr(s)')
            END
        END AS duration_min,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM (1001)'
            WHEN '3G' THEN 'UMTS (1000)'
            WHEN '4G' THEN 'LTE (1004)'
            WHEN '5GNSA' THEN '5G NSA (1004)'
            WHEN '5G' THEN '5G (1006)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS rat,
        CAST(metric AS STRING) as url_kpi,
        CASE
            metric_rat
            WHEN '2G' THEN 'GSM%20(1001)'
            WHEN '3G' THEN 'UMTS%20(1000)'
            WHEN '4G' THEN 'LTE%20(1004)'
            WHEN '5GNSA' THEN '5G%20NSA%20(1004)'
            WHEN '5G' THEN '5G%20(1006)'
            WHEN 'ALL' THEN '-'
            ELSE ''
        END AS url_rat,
        IF(imsi IS NULL, 'Normal', 'VIP') AS url_data_set,
        kpi_threshold_name AS url_kpi_threshold_name,
        comparison_subject_mcc_ref,
        comparison_subject_mnc_ref,
        severity,
        CASE
            severity
            WHEN 1 THEN 'Info'
            WHEN 2 THEN 'Warning'
            WHEN 3 THEN 'Average'
            WHEN 4 THEN 'High'
            WHEN 5 THEN 'Disaster'
            ELSE ''
        END AS severity_grp,
        metric_duration_value,
        -- IFNULL(tx_value, '0') AS tx_value,
        tx_value,
        metric,
        IF(
            comparison_type = 'compare_to_threshold',
            '(Threshold)',
            comparison_type
        ) AS comparison_type,
        operator,
        threshold_value,
        imsi,
        metric_duration_unit,
        COUNT(tbl.tx_datetime) OVER (PARTITION BY tbl.threshold_id) AS alert_cnt,
        CAST(MAX(tbl.tx_datetime) OVER () AS TIMESTAMP) AS overall_max_dt,
        IF(MAX(tbl.tx_datetime) OVER () = tbl.tx_datetime, CONCAT(CAST(tbl.tx_datetime AS STRING), " | "), NULL) AS last_label,
        IF(MAX(tbl.tx_datetime) OVER () = tbl.tx_datetime, tx_value, NULL) AS last_tx_value,
        MAX(tbl.tx_datetime) OVER () AS last_tx_datetime
    FROM (   
        SELECT
            threshold_id,
            tx_datetime,
            data_set,
            status,
            group_id,
            new_cnt,
            new_cnt_vip,
            existing_cnt,
            existing_cnt_vip,
            resolved_cnt,
            resolved_cnt_vip,
            MIN(tx_datetime) OVER (PARTITION BY threshold_id, data_set, session_duration) AS start_dt,
            MAX(tx_datetime) OVER (PARTITION BY threshold_id, data_set, session_duration) + INTERVAL 4 MINUTES + INTERVAL 59 SECONDS AS end_dt,
            (UNIX_TIMESTAMP(MAX(tx_datetime) OVER (PARTITION BY threshold_id, data_set, session_duration) + INTERVAL 5 MINUTES)
            - UNIX_TIMESTAMP(MIN(tx_datetime) OVER (PARTITION BY threshold_id, data_set, session_duration))) AS duration_sec 
        FROM (       
            SELECT threshold_id, 
                CAST(tx_datetime AS TIMESTAMP) AS tx_datetime, 
                data_set,
                status,
                group_id,
                new_cnt,
                new_cnt_vip,
                existing_cnt,
                existing_cnt_vip,
                resolved_cnt,
                resolved_cnt_vip,
                SUM(prev_duration) OVER (PARTITION BY threshold_id, data_set ORDER BY tx_datetime
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                    ) AS session_duration
            FROM (
                SELECT threshold_id, 
                    tx_datetime, 
                    data_set,
                    status,
                    group_id,
                    new_cnt,
                    new_cnt_vip,
                    existing_cnt,
                    existing_cnt_vip,
                    resolved_cnt,
                    resolved_cnt_vip,
                    CASE
                        WHEN lag(latest_duration) OVER (PARTITION BY threshold_id, data_set ORDER BY tx_datetime) = latest_duration AND status = 1 THEN latest_duration
                        WHEN status = 1 THEN 0
                        WHEN status = 0 THEN 1
                        ELSE NULL 
                    END AS prev_duration
                    -- lag(latest_duration) OVER (PARTITION BY threshold_id, data_set ORDER BY tx_datetime) AS prev_duration
                FROM (
                    SELECT tbl.*,
                        SUM(status) OVER (PARTITION BY threshold_id, data_set ORDER BY tx_datetime DESC
                        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                        ) AS latest_duration
                    FROM (
                        SELECT tbl.*, 
                            SUM(IF(tx_dt_id = 1 AND data_set = 1 AND group_id = 1, 1, 0)) OVER () AS new_cnt,
                            SUM(IF(tx_dt_id = 1 AND data_set = 2 AND group_id = 1, 1, 0)) OVER () AS new_cnt_vip,
                            SUM(IF(tx_dt_id = 1 AND data_set = 1 AND group_id = 2, 1, 0)) OVER () AS existing_cnt,
                            SUM(IF(tx_dt_id = 1 AND data_set = 2 AND group_id = 2, 1, 0)) OVER () AS existing_cnt_vip,
                            SUM(IF(tx_dt_id = 1 AND data_set = 1 AND group_id = 3, 1, 0)) OVER () AS resolved_cnt,
                            SUM(IF(tx_dt_id = 1 AND data_set = 2 AND group_id = 3, 1, 0)) OVER () AS resolved_cnt_vip
                        FROM (
                            SELECT
                                threshold_id,
                                tx_datetime,
                                CAST(MAX(tx_datetime) OVER () AS TIMESTAMP) AS max_tx_datetime,
                                date_sub(CAST(MAX(tx_datetime) OVER () AS TIMESTAMP), 1) AS 24_max_dt_datetime,
                                data_set,
                                status,
                                tx_dt_id,
                                CASE
                                    WHEN is_latest = 0 AND is_2_latest = 2 THEN 3
                                    WHEN is_latest = 1 AND is_2_latest = 0 THEN 1
                                    WHEN is_latest = 1 AND is_2_latest = 2 THEN 2
                                    ELSE NULL
                                END AS group_id
                            FROM (
                                SELECT tbl.*,
                                    MAX(IF(status = 1 AND tx_dt_id = 1, 1, 0)) OVER (PARTITION BY threshold_id, data_set) AS is_latest,
                                    MAX(IF(status = 1 AND tx_dt_id = 2, 2, 0)) OVER (PARTITION BY threshold_id, data_set) AS is_2_latest
                                FROM (
                                    SELECT
                                        threshold_id,
                                        tx_datetime,
                                        data_set,
                                        status,
                                        DENSE_RANK() OVER (ORDER BY tbl.tx_datetime DESC) AS tx_dt_id
                                    FROM (
                                        SELECT 
                                            tbl.threshold_id,
                                            tbl.tx_datetime, 
                                            MAX(alert_kpi.max_tx_datetime) OVER () AS max_tx_datetime,
                                            MAX(alert_kpi.min_tx_datetime) OVER () AS min_tx_datetime,
                                            tbl.data_set,
                                            ifnull(status, 0) AS status
                                        FROM (
                                            SELECT distinct data_set, threshold_id, tbl.tx_datetime FROM roam352_report.alert_kpi
                                            CROSS JOIN (SELECT distinct CONCAT(tx_date,' ',LPAD(CAST(tx_hour AS STRING), 2, '0'),':',LPAD(CAST(tx_5m AS STRING), 2, '0'),':00') AS tx_datetime FROM roam352_report.repdata_sys_datetime
                                            where tx_date BETWEEN LEFT(CAST(DATE_SUB(NOW(), 2) AS STRING), 10) AND LEFT(CAST(NOW() AS STRING), 10) 
                                            ) tbl
                                            WHERE par_date BETWEEN CAST(REPLACE(LEFT(CAST(DATE_SUB(NOW(), 2) AS STRING), 10), '-', '') AS INT)
                                                    AND CAST(REPLACE(LEFT(CAST(NOW() AS STRING), 10), '-', '') AS INT)
                                                AND status = 1
                                        ) tbl 
                                        LEFT JOIN (
                                            SELECT 
                                                threshold_id,
                                                tx_datetime, 
                                                MAX(tx_datetime) OVER () AS max_tx_datetime,
                                                CAST(DATE_SUB(CAST(MAX(tx_datetime) OVER () AS TIMESTAMP), 2) AS STRING) AS min_tx_datetime,
                                                data_set,
                                                status
                                            FROM 
                                                roam352_report.alert_kpi 
                                            WHERE 
                                                par_date BETWEEN CAST(REPLACE(LEFT(CAST(DATE_SUB(NOW(), 2) AS STRING), 10), '-', '') AS INT)
                                                    AND CAST(REPLACE(LEFT(CAST(NOW() AS STRING), 10), '-', '') AS INT)
                                                AND status = 1
                                        ) alert_kpi ON alert_kpi.data_set = tbl.data_set AND alert_kpi.threshold_id = tbl.threshold_id AND tbl.tx_datetime = alert_kpi.tx_datetime    
                                    ) tbl
                                        WHERE tbl.tx_datetime BETWEEN min_tx_datetime AND max_tx_datetime
                                ) tbl 
                            ) tbl WHERE is_latest != 0 OR is_2_latest != 0
                        ) tbl WHERE CAST(tx_datetime AS TIMESTAMP) >> 24_max_dt_datetime AND CAST(tx_datetime AS TIMESTAMP) <<= max_tx_datetime
                    ) tbl
                ) tbl
            ) tbl
        ) tbl
    ) tbl INNER JOIN threshold t ON tbl.threshold_id = t.threshold_id AND tbl.data_set = t.data_set
    LEFT JOIN (
        SELECT 
            threshold_id,
            tx_datetime, 
            data_set,
            tx_value
        FROM 
            roam352_report.alert_kpi 
        WHERE 
            par_date BETWEEN CAST(REPLACE(LEFT(CAST(DATE_SUB(NOW(), 2) AS STRING), 10), '-', '') AS INT)
                AND CAST(REPLACE(LEFT(CAST(NOW() AS STRING), 10), '-', '') AS INT)
            AND status = 1
    ) alert_kpi ON alert_kpi.data_set = tbl.data_set AND alert_kpi.threshold_id = tbl.threshold_id AND tbl.tx_datetime = CAST(alert_kpi.tx_datetime AS TIMESTAMP)
) tbl
LEFT JOIN roam352_report.sys_country_profile cty ON CAST(comparison_subject_mcc_ref AS INT) = cty.mcc_ref
LEFT JOIN roam352_report.sys_operator_profile op ON CAST(comparison_subject_mcc_ref AS INT) = op.mcc
    AND comparison_subject_mnc_ref = op.mnc]]></relation>
        </relation>
        <cols>
          <map key='[alert_cnt (Custom SQL Query8)]' value='[Custom SQL Query8].[alert_cnt]' />
          <map key='[alert_cnt]' value='[Custom SQL Query7].[alert_cnt]' />
