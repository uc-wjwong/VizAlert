  <actions>
    <action caption='Filter1' name='[Action13_9F5C94A1D68448089BC27206AF784828]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Alert' type='sheet' worksheet='Trend' />
      <link caption='Filter1' delimiter=',' escape='\' expression='tsl:Trend?%5Bfederated.06mx4tt0velwek148tvn8086cstf%5D.%5BCalculation_1265792977112522754%5D~s0=&lt;[federated.06mx4tt0velwek148tvn8086cstf].[Calculation_1265792977112461313]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='target' value='Trend' />
      </command>
    </action>
    <action caption='Hyperlink1' name='[Action14_AD9736D5B7584C8DAF0E5F57F2E09697]'>
      <activation type='on-select' />
      <source datasource='federated.06mx4tt0velwek148tvn8086cstf' type='datasource'>
        <exclude-sheet name='(Design Used) Last Updated Time' />
        <exclude-sheet name='KPI Item with Alerts' />
        <exclude-sheet name='KPI Item Summary' />
        <exclude-sheet name='(Filter Use) Submit Button' />
        <exclude-sheet name='Resolved_Vizalert' />
        <exclude-sheet name='Alert Count' />
